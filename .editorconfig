root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# Los textos de la interfaz y las pruebas con nombres en español son largos: no se parten a la fuerza.
max_line_length = off
# Las funciones @Composable se nombran con mayúscula inicial.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Las constantes de verdad usan MAYÚSCULAS; las `val` de objeto con nombre propio (clasificador, lector) no.
ktlint_standard_property-naming = disabled
# Los nombres de archivo siguen el nombre en español de lo que contienen.
ktlint_standard_filename = disabled
# Los tests de dominio usan nombres largos con acentos; los parámetros de Compose se listan en una línea.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_blank-line-before-declaration = disabled
ktlint_standard_no-blank-line-in-list = disabled
ktlint_standard_discouraged-comment-location = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_argument-list-wrapping = disabled

# El código generado (SQLDelight, ReglasIncluidas) no se revisa.
[**/build/**]
ktlint = disabled
